  [SHA-1], [переполнение `56 - len % 64` при `len % 64 > 56`; длина в байтах вместо бит; little-endian вместо big-endian в словах, длине и выходе; диапазон `64..80` вместо `60..80`; сдвиг переменных до вычисления $T$],
  [ГОСТ, $L$], [применение к 64 байтам сразу вместо восьми слов; $A_i$ для бита $i$ вместо $A_(63-i)$],
  [ГОСТ, $E$], [все ключи из $K_1$ вместо цепочки $K_(i+1) = "LPS"(K_i xor C_i)$],
  [ГОСТ, $g$], [ключ из $h xor m$ вместо $h xor N$],
  [ГОСТ, этап 3], [пропуск последнего блока при остатке 0 (пустое сообщение, длина кратна 64 байтам)],
  [ГОСТ, константы], [опечатки в трёх строках $C_i$ при переписывании (11 байт)],
  [ГОСТ, порядок байтов], [часть функций в little-endian, часть в big-endian],
