@startuml
title Режим простой замены

skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam monochrome true
skinparam shadowing false
skinparam ActivityBorderThickness 1

start
:Вход: данные, ключ K, режим;
if (Зашифрование ?) then (да)
  :дополнить открытый текст нулями\nдо кратности 8 байт;
  :запомнить число добавленных байт;
else (нет)
  :извлечь последний байт шифротекста\nкак число байт дополнения;
endif

while (остались необработанные блоки ?) is (да)
  :взять очередные 8 байт;
  :N1 := первые 4 байта,\nN2 := последние 4 байта;
  :(N1, N2) := базовое преобразование(N1, N2, K, режим);
  :дописать N1, N2 в результат;
endwhile (нет)

if (Зашифрование ?) then (да)
  :дописать в результат байт\nчисла добавленных байт;
else (нет)
  :удалить из результата\nбайты дополнения;
endif
:Выход: результат;
stop

@enduml
