@startuml
title Блок-схема алгоритма Мак-Элиса на кодах QC-MDPC\n(зашифрование и расшифрование сообщения)

skinparam defaultFontName "Times New Roman"
skinparam defaultFontSize 14
skinparam monochrome true
skinparam shadowing false
skinparam ActivityBorderThickness 1

start
:Вход: сообщение M, ключ, направление;
note right
  Кольцо R = GF(2)[x] / (x^r - 1), r = 12 323
  Открытый ключ: A = a, B = a·q, t
  Закрытый ключ: h0, h1 (по d = 71 единице), a^-1
  k = floor(r / 8) байт текста в блоке,
  h = ceil(r / 8) байт в половине шифроблока
  Сложение векторов: XOR
end note

if (зашифрование ?) then (да)
  :M := M || 01 || 00 ... 00\n(дополнение до длины, кратной k);
  :i := 1;
  while (i <= |M| / k ?) is (да)
    :m := i-й кусок M из k байт,\nдополненный нулями до r бит;
    :Выбрать t различных позиций из 2r:\nпозиции < r идут в e0, остальные (минус r) в e1;
    :c0 := m·A + e0\nc1 := m·B + e1;
    :C[i] := c0 || c1 (по h байт);
    :i := i + 1;
  endwhile (нет)
  :Выход: C[1] || ... || C[|M| / k];
else (нет)
  if (|C| mod 2h <> 0 ?) then (да)
    :Ошибка: неверная длина;
    stop
  else (нет)
  endif
  :i := 1;
  while (i <= |C| / 2h ?) is (да)
    :(c0, c1) := i-й блок C;
    :s := c0·h0 + c1·h1\ne0' := 0, e1' := 0, j := 0;
    while (s <> 0 и j < 10 ?) is (да)
      :upc0(p) := число единиц s в позициях p + supp(h0)\nupc1(p) := число единиц s в позициях p + supp(h1)\nдля всех p = 0 ... r - 1;
      :T := max(floor(0.0069722·|s| + 13.530), 36);
      if (есть счётчики >= T ?) then (да)
        :Для каждого p с upc0(p) >= T: e0'[p] инвертировать, s := s + x^p·h0\nдля каждого p с upc1(p) >= T: e1'[p] инвертировать, s := s + x^p·h1;
      else (нет)
        :Ошибка: отказ декодера;
        stop
      endif
      :j := j + 1;
    endwhile (нет)
    if (s = 0 и |e0'| + |e1'| = t ?) then (да)
    else (нет)
      :Ошибка: отказ декодера;
      stop
    endif
    :m := (c0 + e0')·a^-1;
    if (c1 + e1' = m·B ?) then (да)
    else (нет)
      :Ошибка: блок искажён;
      stop
    endif
    :X[i] := первые k байт m;
    :i := i + 1;
  endwhile (нет)
  :M := X[1] || ... || X[|C| / 2h];
  :Отбросить нулевые байты в конце M;
  if (последний байт M = 01 ?) then (да)
    :Отбросить его;
  else (нет)
    :Ошибка: неверное дополнение;
    stop
  endif
  :Выход: M;
endif
stop

@enduml
