  columns: (auto, 1fr),
  [Шаг], [Значение],
  [$S$], [$alpha^3 x + alpha^2$],
  [$T = S^(-1)$], [$x + alpha^3$ (обратное к обратному)],
  [$T + x$], [$alpha^3$],
  [$tau = sqrt(alpha^3)$], [$alpha^9$, так как $alpha^18 = alpha^3$],
  [Евклид], [$deg tau = 0 <= 1$: сразу $a = alpha^9$, $b = 1$],
  [$sigma = a^2 + x b^2$], [$alpha^18 + x = x + alpha^3$],
  [Корень], [$alpha^3$ -- найдена ошибка],
)

== Две ошибки (в позициях $alpha^3$ и $alpha^10$)

#table(
  columns: (auto, 1fr),
  [Шаг], [Значение],
  [$S$], [$(alpha^3 + alpha^6) x + (alpha^2 + alpha^11) = alpha^2 x + alpha^9$],
  [$T = S^(-1)$], [$alpha^14 x + alpha^8$],
  [$T + x$], [$alpha^3 x + alpha^8$],
  [$tau = sqrt(T + x)$], [$p_0 = sqrt(alpha^8) = alpha^4$, $p_1 = sqrt(alpha^3) = alpha^9$; $tau = alpha^4 + alpha^9 (x + alpha^11) = alpha^9 x + alpha^8$],
  [Евклид], [$deg tau = 1 <= 1$: сразу $a = alpha^9 x + alpha^8$, $b = 1$],
  [$sigma = a^2 + x b^2$], [$alpha^18 x^2 + alpha^16 + x = alpha^3 x^2 + x + alpha$],
  [Корни], [$alpha^3$ и $alpha^10$ -- обе ошибки найдены],
)

Действительно, $alpha^3 (x + alpha^3)(x + alpha^10) = alpha^3 x^2 + alpha^3 (alpha^3 + alpha^10) x + alpha^16 = alpha^3 x^2 + x + alpha$,
так как $alpha^3 + alpha^10 = alpha^12$ и $alpha^3 dot alpha^12 = 1$. Найденный
$sigma$ отличается от $product (x - alpha_i)$ множителем $alpha^3$ -- ровно как
обещает раздел 7.4.

#note(title: "Почему здесь нет шагов Евклида")[
  При $t = 2$ граница остановки $floor(t \/ 2) = 1$, а $deg tau <= t - 1 = 1$
  всегда, поэтому алгоритм останавливается на нулевом шаге и $b = 1$. Для
  $t = 50$ до остатка степени 25 проходит порядка 25 шагов деления.
]

